        <color>ff1b1b99</color>
        <width>2.5</width>
      </LineStyle>
      <PolyStyle>
        <color>261b1b99</color>
      </PolyStyle>
    </Style>

    <!-- Studio Base Placemark -->
    <Placemark>
      <name>THE Occasion Edit — Bottesford Studio Base</name>
      <description>Studio HQ: Bottesford, Leicestershire, NG13. Delivery base for the Vale of Belvoir and East Midlands.</description>
      <Point>
        <coordinates>-0.8006,52.9436,0</coordinates>
      </Point>
    </Placemark>

