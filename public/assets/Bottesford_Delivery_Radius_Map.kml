  <Document>
    <name>THE Occasion Edit — Delivery Zones (Bottesford Studio)</name>
    <description>Bespoke balloon styling, sequin shimmer walls and event decor delivery radiuses from Bottesford Studio (52.9436, -0.8006).</description>
    
    <!-- Zone 1 Style: Sage Green -->
    <Style id="zone1Style">
      <LineStyle>
        <color>ff688c7a</color>
        <width>2.5</width>
      </LineStyle>
      <PolyStyle>
        <color>40688c7a</color>
      </PolyStyle>
    </Style>

    <!-- Zone 2 Style: Studio Gold -->
    <Style id="zone2Style">
      <LineStyle>
        <color>ff59a0c5</color>
        <width>2.5</width>
      </LineStyle>
      <PolyStyle>
        <color>3359a0c5</color>
      </PolyStyle>
    </Style>

    <!-- Zone 3 Style: Crimson -->
    <Style id="zone3Style">
